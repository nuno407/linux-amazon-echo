# The board's drivers, added to cronos.config before `make olddefconfig`.
# The panel (patches/panel-amazon-cronos-st7701s.c).
CONFIG_DRM_PANEL_AMAZON_CRONOS_ST7701S=y
# The sound card, the microphone FPGA and its ADC (patches/0005-mt8163-cronos-sound.sh, 0006, 0007).
CONFIG_SND_SOC_MT8163_CRONOS=y
CONFIG_SND_SOC_AMAZON_SPI_PCM=y
CONFIG_SND_SOC_TLV320AIC3101=y
# /dev/Vcodec for MediaTek's codec libraries (patches/mt8163-vcodec.c), a module: loaded once the
# system is up, so a fault in it never keeps the unit from booting
CONFIG_MT8163_VCODEC=m
