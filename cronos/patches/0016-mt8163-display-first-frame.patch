+static bool mtk_crtc_frame_seen(struct mtk_crtc *mtk_crtc)
+{
+	struct drm_crtc *crtc = &mtk_crtc->base;
+	u64 count;
+	bool seen;
+
+	if (drm_crtc_vblank_get(crtc))
+		return true;
+	count = drm_crtc_vblank_count(crtc);
+	seen = wait_event_timeout(*drm_crtc_vblank_waitqueue(crtc),
+				  drm_crtc_vblank_count(crtc) != count,
+				  msecs_to_jiffies(100)) > 0;
+	drm_crtc_vblank_put(crtc);
+	return seen;
+}
+
+/*
+ * On the MT8163 the bootloader sometimes leaves the overlay's memory read wedged (its own boot then
+ * waits out a timeout and shows nothing). Its clocks are still running when the kernel takes over,
+ * so the first enable resets and programs the pipeline without ever gating them, and the overlay
+ * stays stuck: no frame ever completes. A full disable, with the overlay, SMI larb and SMI common
+ * runtime-suspended and their clocks gated, followed by a fresh enable, clears it. A deeper wedge,
+ * with a read lost inside the SMI, also needs the SMI common, larb and overlay resets while
+ * everything is down (the resets leave the SMI's registers as they are), and a power-down of about a
+ * second; one such cycle has not always been enough. So when the first enable produces no frame,
+ * try up to three cycles. The SMI resets are the overlay node's "smi-common" and "smi-larb" resets,
+ * if it has them.
+ */
+static void mtk_crtc_reset_smi(struct device *dev)
+{
+	static const char * const names[] = { "smi-common", "smi-larb" };
+	struct reset_control *rst;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		rst = reset_control_get_optional_exclusive(dev, names[i]);
+		if (IS_ERR_OR_NULL(rst))
+			continue;
+		reset_control_reset(rst);
+		reset_control_put(rst);
+	}
+}
+
+static void mtk_crtc_first_frame_work(struct work_struct *work)
+{
+	struct mtk_crtc *mtk_crtc = container_of(to_delayed_work(work), struct mtk_crtc,
+						 first_frame_work);
+	struct drm_crtc *crtc = &mtk_crtc->base;
+	struct drm_device *drm = crtc->dev;
+	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[0];
+	struct device *dev = comp->dev;
+	int ret, ms, try;
+
+	if (!mtk_crtc->enabled || mtk_crtc_frame_seen(mtk_crtc))
+		return;
+
+	drm_warn(drm, "[CRTC:%d] no frame after the first enable; powering the pipeline down and up\n",
+		 crtc->base.id);
+	for (try = 1; try <= 3; try++) {
+		ret = drm_mode_config_helper_suspend(drm);
+		if (ret) {
+			drm_err(drm, "[CRTC:%d] disabling the pipeline failed: %d\n", crtc->base.id, ret);
+			return;
+		}
+		for (ms = 0; ms < 1000 && !pm_runtime_suspended(dev); ms += 10)
+			msleep(10);
+		/*
+		 * The SMI larb and common follow the overlay down through their device links, but
+		 * asynchronously: reset them only once they are surely down, with their clocks gated.
+		 */
+		msleep(1000);
+		if (pm_runtime_suspended(dev)) {
+			mtk_crtc_reset_smi(dev);
+			if (comp->id == DDP_COMPONENT_OVL0)
+				mtk_ovl_reset(dev);
+		}
+		ret = drm_mode_config_helper_resume(drm);
+		if (ret) {
+			drm_err(drm, "[CRTC:%d] re-enabling the pipeline failed: %d\n", crtc->base.id, ret);
+			return;
+		}
+		if (mtk_crtc->enabled && mtk_crtc_frame_seen(mtk_crtc)) {
+			drm_info(drm, "[CRTC:%d] pipeline power-cycled %d time(s): frames running\n",
+				 crtc->base.id, try);
+			return;
+		}
+	}
+	drm_err(drm, "[CRTC:%d] pipeline power-cycled 3 times: still no frame\n", crtc->base.id);
 }
 
