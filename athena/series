# The board files and patches, in the order they are applied: one shell command a line, run from the
# work directory with PUB (this directory), BASE (the board files build.sh fetched, with
# base-patches/ applied), KTREE (the kernel tree), DTSDIR, DTS (the athena DTS in the tree) and PANEL
# set. An overlay gives its own series, with these steps and its own in between (README.md,
# "Overlays").
cp "$BASE/dts/mt8183-amazon-athena.dts" "$DTSDIR/"
python3 "$PUB/patches/panel-dts.py" "$DTS" "$PANEL"
python3 "$PUB/patches/gpu-dts.py" "$DTS"
python3 "$PUB/patches/scp-dts.py" "$DTS"
python3 "$BASE/dsp_slot.py" empty "$DTSDIR/mt8183-amazon-athena-dsp-slot.bin"
cp "$BASE/src/mt8183-athena.c" "$KTREE/sound/soc/mediatek/mt8183/"
grep -q "leave cache-only mode before the clocks are enabled" "$KTREE/sound/soc/mediatek/mt8183/mt8183-afe-pcm.c" || patch -d "$KTREE" -p1 -N -s --no-backup-if-mismatch -i "$BASE/patches/0001-mt8183-afe-leave-cache-only-before-enabling-clocks.patch"
python3 "$PUB/patches/port-7.2.py" "$KTREE" "$BASE/patches"
python3 "$BASE/patches/patch-kbuild.py" "$KTREE"
python3 "$BASE/patches/patch-afe-di2.py" "$KTREE"
python3 "$BASE/patches/patch-afe-awb-dl1.py" "$KTREE"
python3 "$BASE/patches/patch-usb-force-vbus.py" "$KTREE"
python3 "$BASE/patches/patch-btmtksdio-bdaddr.py" "$KTREE"
python3 "$BASE/patches/patch-btmtksdio-p192.py" "$KTREE"
python3 "$BASE/patches/patch-btmtksdio-late-register.py" "$KTREE"
python3 "$BASE/patches/patch-mt7663s-firmware-hold.py" "$KTREE"
python3 "$BASE/patches/patch-display.py" "$KTREE"
python3 "$PUB/patches/jd9365-dsi-mode.py" "$KTREE"
python3 "$PUB/patches/jd9365-power-mode-log.py" "$KTREE"
python3 "$PUB/patches/mtk-dsi-cmd-clock-lp.py" "$KTREE"
python3 "$BASE/patches/patch-tas5805m-dsp-slot.py" "$KTREE"
python3 "$BASE/patches/patch-cci-sram.py" "$KTREE"
python3 "$BASE/patches/patch-thermal-devinfo.py" "$KTREE"
python3 "$PUB/patches/mt7663s-temperature.py" "$KTREE"
python3 "$PUB/patches/mtk-jpeg-enc-error.py" "$KTREE"
python3 "$PUB/patches/mdp3-mt8183-cros-abi.py" "$KTREE"
python3 "$PUB/patches/mdp3-cached-capture.py" "$KTREE"
python3 "$PUB/patches/mdp3-rgba.py" "$KTREE"
python3 "$PUB/patches/wdt-kexec.py" "$KTREE"
